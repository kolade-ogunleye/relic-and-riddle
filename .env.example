# ==============================================================================
# AUTONOMOUS META CONTENT ENGINE — CONFIGURATION
# ==============================================================================

# --- Upload-Post.com Publishing API ---
# Get your API key from your active Upload-Post dashboard: https://upload-post.com
UPLOAD_POST_API_KEY=your_upload_post_api_key_here
UPLOAD_POST_BASE_URL=https://api.upload-post.com/api/upload

# --- Telegram Bot Approval Gatekeeper ---
# 1. Create a bot via @BotFather on Telegram to get your bot token
# 2. Get your user ID from @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- LLM Engines (Claude / Gemini) ---
# Used for Stage 2 (Script Writing) & Stage 2.5 (Fact-Check Claim Verification)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Kling Video & Visual Generation (Optional / Modular) ---
# If calling Kling API directly or batching UI clips
KLING_API_KEY=your_kling_api_key_here

# --- Publishing & Compliance Settings ---
META_IS_AI_GENERATED=true
DEFAULT_TIMEZONE=America/New_York
SCHEDULE_DAILY_RUN_TIME=09:00
