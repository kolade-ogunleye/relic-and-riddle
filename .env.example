# ==============================================================================
# RELIC & RIDDLE — MASTER CONFIGURATION TEMPLATE (.env.example)
# Copy this file to `.env`. Real environment variables override these values.
# Provision a separate .env in each environment. Never deploy dev's .env to production.
# Dev and production have different Telegram bots; chat/approver IDs identify humans.
# Run `python main.py health --live` to audit credentials and connected services.
# ==============================================================================

# ==============================================================================
# SECTION 1: SCRIPT RESEARCH, FACT-CHECKING & LLM
# ==============================================================================
# SCRIPT_ENGINE: "free" = Gemini Free Tier on GEMINI_FREE_API_KEY (from a Google
# Cloud project WITHOUT billing, so it can NEVER incur financial charges). Uses
# Wikipedia + OpenAlex + UNESCO evidence for search-grounded drafting.
# "claude" = Anthropic Claude pipeline with web search grounding.
SCRIPT_ENGINE=free
# The hook rule is fixed in src/config.py, not a setting (QF-14): the narration's first sentence is at most
# HOOK_MAX_WORDS=12 spoken words with a number, scale, contrast or question within its first HOOK_SIGNAL_WITHIN=8.
# An opening over the cap blocks; a missing signal gets one opening edit (a heavy writer call), then ships
# flagged on the review card (operator ruling 2026-11-10).
# The payoff rule is fixed too, not a setting (QF-15): payoff_sentence is the penultimate sentence and names a noun
# of the first one, checked offline by the committed spaCy model (src/config.py PAYOFF_NLP_DIR, data/nlp).

# --- Gemini (Free Tier & Anti-Hallucination Vision) ---
# Get key from https://aistudio.google.com (ensure billing is disabled for $0 guarantee)
GEMINI_FREE_API_KEY=your_gemini_free_api_key_here
# Spare free key from another Google project. Not used while GEMINI_SPARE_KEY_PERMITTED=false:
# Google's API terms forbid circumventing limits (free limits are per project). Turn on only if
# Google's terms come to allow it; no code change is needed then.
GEMINI_FREE_API_KEY_SPARE=
GEMINI_SPARE_KEY_PERMITTED=false
# Second free model for light text tasks (sound plan, /ask, issue sorting) when the free Gemini
# quota runs out: https://console.groq.com/keys. Turn GROQ_LIGHT_FALLBACK on only after
# `python scripts/compare_light_engines.py` shows it holds up.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_LIGHT_FALLBACK=false
# A DIFFERENT key, from a billed project (grounding, face checks). Never reuse the free key here:
# `health --live` flags a shared key, because then the free path is billable.
GEMINI_API_KEY=your_gemini_api_key_here
# When the free quota is used up: monthly USD caps for using GEMINI_API_KEY instead (0 = never).
# light = photo review and sound plan (cents per call); heavy = script writing and fact checks.
PAID_FALLBACK_LIGHT_MONTHLY_USD=5
PAID_FALLBACK_HEAVY_MONTHLY_USD=0
FREE_WRITER_MODEL=gemini-3.8-flash
# A different model checks the writer's work (an independent second opinion).
FREE_CHECKER_MODEL=gemini-3.7-flash
# Light text tasks on their own free Gemini model (its own free limits, same project). Empty = the
# writer/checker models. Set only after scripts/compare_light_engines.py --candidate gemini:<model> holds up.
FREE_LIGHT_MODEL=
GEMINI_MODEL=gemini-3.8-flash

# --- Anthropic Claude (Required only if SCRIPT_ENGINE=claude) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FALLBACK_MODELS=claude-sonnet-5-5
# Monthly spend cap in USD (0 = unconstrained). /status shows month-to-date spend.
CLAUDE_MONTHLY_BUDGET_USD=0
# On the free engine, use Claude only when free and billed Gemini both fail (needs the cap above > 0)
CLAUDE_FALLBACK=false
# Heavy tasks (scripts, fact checks) on the free key first (true) or straight to the capped billed key
# (false). Dev and production share the free key; production sets false so dev keeps the free quota.
FREE_TIER_HEAVY=true
# The picture plan is retried within the run before photos are matched by their captions:
# tries, and the first wait in seconds (doubling each time)
SCENE_PLAN_ATTEMPTS=3
SCENE_PLAN_RETRY_SECONDS=60
# A narration a little over the time limit is read up to this much faster instead of rewritten (1.0-1.15).
# Azure and Edge only, at their native rate; ElevenLabs ignores speed and no voice is ever time-stretched.
SPEECH_SPEEDUP_MAX=1.08
# Used once the monthly budget is reached; empty = stop instead.
CLAUDE_BUDGET_MODEL=claude-haiku-5-5

# Dual-Check Escalation Guardrails
SECOND_CHECK_ENABLED=true
SECOND_CHECK_MODELS=claude-fable-5-1,claude-opus-5-5
SECOND_CHECK_ESCALATION_MODEL=claude-fable-5-1
LIGHT_TASK_MODELS=claude-sonnet-5-5,claude-opus-5-5

# Signed fact-check records (SECRET). Every fact-check record (the release gate's fact review, its checker
# record, and the design cards' field records) is signed with HMAC-SHA256 under this key when the checker
# runs, and verified wherever it is trusted. Make one per environment, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"
# At least 32 bytes; a shorter key or a "your_..." placeholder counts as unset.
# Unset: nothing is signed, so nothing is trusted. With RELIC_ENVIRONMENT=production the script stage and the
# fact check refuse to run and nothing publishes; in development every record stays untrusted. Changing the key makes every earlier
# record untrusted: the next run re-checks its copy (checker calls are spent again). Never share or log it.
FACT_RECORD_KEY=
# Quote cards are held (default false). Do NOT enable until FACT_RECORD_KEY is set and a real checker key
# exists; the speaker, work and date must then come only from the checker's signed record.
QUOTE_CARDS_ENABLED=false


# ==============================================================================
# SECTION 2: VOICEOVER NARRATION (TTS) & TIMING
# ==============================================================================
# VOICE_PREFER: which licensed voice real runs try first; the other is the fallback.
# "elevenlabs" = your ElevenLabs voice (needs a paid plan for the commercial licence).
# "azure" = Azure Speech F0 (free: 0.5M characters a month, commercially licensed).
VOICE_PREFER=elevenlabs
# Real (non-dry) runs use only commercially licensed voices (Azure, or ElevenLabs on a paid plan).
# false lets a real run be voiced by edge-tts, which has no commercial licence; publishing then blocks it.
VOICE_REQUIRE_LICENSED=true

# --- Azure Speech (free F0 tier: create a standalone "Speech" resource, not a Foundry resource) ---
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
# Also the voice that measures a script's spoken length before the real voiceover.
NARRATOR_VOICE=en-US-BrianMultilingualNeural
NARRATOR_RATE=-2%
NARRATOR_PITCH=-2Hz

# --- ElevenLabs ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Replace with your own designed voice (Voices > Voice Design); the default is the stock "Adam".
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# eleven_v4 is ElevenLabs' recommended narration model; the fallback is used if it rejects a request.
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_FALLBACK_MODEL=eleven_multilingual_v2
ELEVENLABS_SPEED=1.0
# The voice's format: pcm_48000 (lossless, 48 kHz) where the plan offers it. A plan without it: pcm_44100 or
# pcm_24000, or last mp3_44100_192 (decoded to WAV). The voiceover is always written as WAV (voiceover.wav).
ELEVENLABS_OUTPUT_FORMAT=pcm_48000
# Creator uses 192 kbps MP3, decoded once to WAV, preserving the previous bandwidth.
# Explicit alternative: pcm_24000 (lossless but limited to 12 kHz audio bandwidth).
ELEVENLABS_FALLBACK_FORMAT=mp3_44100_192
# Free/Starter retain their 128 kbps MP3 format; lower-rate PCM requires an explicit choice.
ELEVENLABS_BASIC_FALLBACK_FORMAT=mp3_44100_128
# Plans that go straight to the Creator fallback. Free/Starter use the basic setting.
# Other/unknown plans try the preferred format, Creator fallback, then basic fallback.
ELEVENLABS_FALLBACK_FORMAT_TIERS=creator
# Fixed seed so a re-take of the same text reads the same way (best effort on ElevenLabs' side)
ELEVENLABS_SEED=1
# false: dry runs use the free Azure voice, so tests never spend ElevenLabs credits.
ELEVENLABS_IN_DRY_RUNS=false
# Dry runs buy the AI motion clip too (within MEDIA_MONTHLY_BUDGET_USD): on, validation looks like the live product
MOTION_IN_DRY_RUNS=false
# Runs started from the bot (main.py bot, development) are dry runs; false lets Approve & Post publish
BOT_RUNS_DRY=true
# A minor finding of the visual audit blocks release (true, every finding blocks) or is shown on the review
# card without blocking (false; the operator decides from its severity, 2026-10-28); major and critical
# findings always block
MINOR_FINDINGS_BLOCK_RELEASE=false
# The longest recorded voiceover kept, in seconds (the script is planned for 42-48 s, under 52 s); with the 2.9 s
# end card the master stays under the 58 s release limit and YouTube Shorts' 60 s (operator, 2026-10-28)
VOICE_DURATION_CEILING=54.5


# ==============================================================================
# SECTION 3: BACKGROUND MUSIC & ACOUSTIC ATMOSPHERE
# ==============================================================================
# MUSIC_PREFER: "library" = Approved CC0 / CC BY royalty-free tracks in data/music/library.json,
# falling back to procedural dual-sine ambient drone (55Hz + 82.5Hz) synthesized at $0.00.
# "elevenlabs" = Uses ElevenLabs Music generation API (paid credit consumption).
MUSIC_PREFER=library
# Tracks one "Find new tracks" tap downloads per mood (each still needs your review)
MUSIC_FETCH_PER_MOOD=3
# Sound-effect headroom (dBFS): each one-shot effect's peak in the music bed before its cue gain, and the ceiling
# of the bed bus (music, setting layer and effects), which is limited on its own before the narration is mixed in.
SFX_PEAK_DBFS=-17.0
SFX_BUS_CEILING_DBFS=-6.0
# YouTube visibility for an approved 16:9 documentary: public, unlisted or private
YOUTUBE_PRIVACY=public
# Which video formats run: reel, documentary, or reel,documentary. A format not listed is paused on
# every route (Telegram, command line); the daily scheduled run makes every listed format.
# The 16:9 documentary is a work in progress (docs/documentary-rebuild.md): production lists only
# reel until it is accepted; development lists both to keep rebuilding it.
VIDEO_FORMATS=reel
# Also upload each approved Reel to YouTube as a Short (separate upload after Facebook/Instagram). On by default
# (QF-83); false turns it off. YouTube shows a frame of the video as a Short's thumbnail: none is sent.
YOUTUBE_SHORTS=true
# The Reel's one-second loop bridge says FOLLOW (bone, centred, gone by the loop's seam; no added time). On by
# default (QF-83, operator 2026-11-10); false keeps the bridge purely visual.
LOOP_FOLLOW_OVERLAY=true
# Shorts visibility: public, unlisted or private (defaults to YOUTUBE_PRIVACY). Public once live: an unlisted
# Short is reachable only by its link and is never shown in the Shorts feed (operator, 2026-10-27).
YOUTUBE_SHORTS_PRIVACY=public
# YouTube's audience-retention curve per Short (src/youtube_analytics.py; read-only, yt-analytics.readonly). Run
# scripts/youtube_analytics_auth.py once on your machine as the channel owner and paste the three values it prints.
# Left empty, YouTube keeps its counts only (views, likes, comments).
YOUTUBE_ANALYTICS_CLIENT_ID=
YOUTUBE_ANALYTICS_CLIENT_SECRET=
YOUTUBE_ANALYTICS_REFRESH_TOKEN=


# ==============================================================================
# SECTION 4: AI MOTION HOOK & ANTI-HALLUCINATION GATE
# ==============================================================================
# MEDIA_MONTHLY_BUDGET_USD: Monthly spend cap in USD for pay-per-use AI video APIs and AI illustrations
# (the illustration tier, IMAGE_GEN_*), counted together in one ledger.
# Set to 0 to run in 100% FREE MODE (uses local 2.5D Depth Anything V2 Parallax + procedural graphics;
# no illustration request is made).
# Set to 10 or 20 to enable the Kling 3.0 motion hook.
MEDIA_MONTHLY_BUDGET_USD=0
MOTION_MAX_CLIPS=1
# MUSEUM_LINE_SEARCH: search museum and archive open-access collections (The Met, NASA; Smithsonian and
# Europeana when their keys are set) for a line Commons cannot show. true (default) or false.
MUSEUM_LINE_SEARCH=true

# --- Kling 3.0 API ---
# Key from https://kling.ai/
KLING_API_KEY=your_kling_api_key_here



# ==============================================================================
# SECTION 5: REAL FOOTAGE & ARCHIVAL IMAGERY
# ==============================================================================
# Operator-supplied footage: send a video file to the bot with the caption "/footage <topic>".
FOOTAGE_ENABLED=true
FOOTAGE_MAX_SHARE=0.40           # Max 40% of runtime to respect Meta originality policies
FOOTAGE_MAX_MB=600

# Per-beat Wikimedia Commons image search (CC BY-SA is excluded by default for copyright safety)
BEAT_IMAGES_ENABLED=true
# A found picture is looked at (one light vision call) before it is kept; off keeps the title/metadata checks only
PICTURE_VISION_CHECK=true
# Seconds before a failed picture check is asked once more; still failing, the picture is left out (not used unlooked at)
PICTURE_CHECK_RETRY_SECONDS=15
# A look at each rendered Story frame and carousel slide; findings shown on the review card, never a block.
STILL_VISION_CHECK=true
# true accepts CC BY-SA images everywhere (fetch, upload, release); each video using one is then
# published under CC BY-SA 4.0 and the release gate requires that notice in the post.
# (BEAT_IMAGES_ALLOW_SHARE_ALIKE: the old name, still honoured if IMAGES_ALLOW_SHARE_ALIKE is unset)
IMAGES_ALLOW_SHARE_ALIKE=false
COMMONS_CONTACT=your_email@domain.com
# The brand's public contact (URL or email) in the archive.org client's User-Agent. Empty: brand and purpose only.
BRAND_CONTACT=
# Largest picture download read (MB); a larger body is refused before it is decoded
COMMONS_DOWNLOAD_MAX_MB=50
# Smithsonian Open Access (CC0 images): free key from https://api.data.gov/signup/ (keep it private).
SMITHSONIAN_API_KEY=
# Europeana photo and film source (free key: pro.europeana.eu, "Get your API key"); empty = not used
EUROPEANA_API_KEY=
# Largest archive film downloaded to cut one segment from (MB); the original is deleted once the segment is cut
ARCHIVE_FILM_MAX_MB=250

# Generative Gap-Filling Subsystem (Phase 2.5): Era-matched monochrome linework synthesized
# for unphotographed historical beats, via GEMINI_API_KEY. The model is IMAGE_GEN_MODEL (default
# gemini-3-pro-image, Gemini generateContent with image output; Imagen 3 was shut down on 2025-11-10).
# See the illustration-tier block (IMAGE_GEN_*) below.
GENERATIVE_GAP_FILLING=true
MAX_GAP_IMAGES_PER_RUN=2


# ==============================================================================
# SECTION 6: MULTI-PLATFORM PUBLISHING & DISTRIBUTION
# ==============================================================================
# Publisher 1: Upload-Post.com (Automated SaaS distribution for Facebook + Instagram)
UPLOAD_POST_API_KEY=your_upload_post_api_key_here
UPLOAD_POST_USER=your_upload_post_profile_name
UPLOAD_POST_BASE_URL=https://api.upload-post.com/api
UPLOAD_POST_FACEBOOK_PAGE_ID=

# Publisher 2: Direct Instagram Graph API (Free direct Meta Developer App fallback)
META_ACCESS_TOKEN=your_meta_system_user_token_here
META_IG_ACCOUNT_ID=your_instagram_business_account_id_here
META_GRAPH_VERSION=v26.0

# Publisher 3: Facebook Page Reels Direct
META_PAGE_ID=your_facebook_page_id_here
META_PAGE_ACCESS_TOKEN=


# ==============================================================================
# SECTION 7: TELEGRAM HUMAN-IN-THE-LOOP (HITL) APPROVAL
# ==============================================================================
# 1. Create bot with @BotFather on Telegram.
# 2. Retrieve your numeric user ID from @userinfobot.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_numeric_telegram_user_id_here
TELEGRAM_APPROVER_IDS=your_numeric_telegram_user_id_here
APPROVAL_TIMEOUT_SECONDS=3600

# Telegram Bot Chat Upgrade v2 (Topics & Two-Card System)
TELEGRAM_CARDS_V2=false
RELIC_STRICT_TOPICS=false
# The forum topic (message_thread_id) of each card stream in your Telegram group: open the topic, copy its link
# (t.me/c/<group>/<topic id>). Unset: the defaults in src/config.py.
# TELEGRAM_TOPIC_STUDIO=your_studio_topic_id
# TELEGRAM_TOPIC_NEEDS=your_needs_topic_id
# TELEGRAM_TOPIC_REVIEWS=your_reviews_topic_id
# TELEGRAM_TOPIC_RUNS=your_runs_topic_id
# TELEGRAM_TOPIC_INFO=your_info_topic_id


# ==============================================================================
# SECTION 8: OPERATIONS, SCHEDULING & DESIGN
# ==============================================================================
# Visual Design & Typography
FONT_NAME=Anton
# 9:16 caption size in px (80 since 2026-11-03). A .env still saying FONT_SIZE=72 keeps the old size, and the
# pipeline warns at each run's start: remove that line or set 80.
FONT_SIZE=80
META_IS_AI_GENERATED=true
DEFAULT_TIMEZONE=America/New_York
POST_TIMEZONE=America/New_York
SCHEDULE_DAILY_RUN_TIME=09:00
POST_SCHEDULING=true
REEL_POST_TIMES=12:00,19:00
STORY_DELAY_MINUTES=45
# Covers (QF-82): a run renders only its final cover and profile-grid tile; automatic selection stays on the
# fixed badge style (src/config.py COVER_FIXED_STYLE) until a cover-specific signal exists. No switch unfreezes it.
CAROUSEL_DAYS=tue,wed,thu
# A carousel posts no sooner than this many hours after its Reel (Upload-Post flags similar content within 48 h:
# don't go lower), and expires this many days after its Reel posts (or after the Reel's slot while it hasn't posted),
# but never before its first carousel slot after that gap, so every carousel gets one
CAROUSEL_GAP_HOURS=48
CAROUSEL_MAX_AGE_DAYS=7

# Operational Heartbeat & Dead-Man's Switch
HEARTBEAT_TIME=08:00
# Free monitoring check at https://healthchecks.io
HEALTHCHECK_PING_URL=your_healthchecks_io_ping_url_here

# ---------------------------------------------------------------------------
# Optional settings (the code defaults are shown; uncomment to change them)
# ---------------------------------------------------------------------------
# Real-ESRGAN upscaler binary for stills too small for a sharp 1080x1920 crop.
# REALESRGAN_BIN=tools/realesrgan/realesrgan-ncnn-vulkan.exe
# DirectML adapter for upscaling and depth: auto prefers a discrete GPU; or a DXGI index.
# Logs the chosen GPU name and warns when it uses integrated graphics or falls back to CPU.
ONNX_DML_DEVICE=auto
# Labelled callouts on photos (off by default).
# CALLOUTS_ENABLED=false
# Blur living people's faces in photos before rendering, and the skin-tone share that counts as a face.
# FACE_PRIVACY_ENABLED=true
# FACE_PRIVACY_SKIN_THRESHOLD=0.35
# Face verification on this machine (YuNet's score, face size and a printed-letter check; archival
# photos are blurred like colour ones). true sends photos and face crops to the billed Gemini key and to Anthropic as named
# processors (docs/privacy.md); off by default.
# FACE_VERIFY_CLOUD=false
# With FACE_VERIFY_CLOUD off: send only the face crops the local check cannot tell from carvings, paintings or
# stained glass (art-like photos) to Gemini on GEMINI_API_KEY. Turn on only once that key is on Google's paid tier;
# off (or a failed call) blurs them. Each call is recorded in llm_usage (docs/privacy.md).
# FACE_VERIFY_CLOUD_AMBIGUOUS=false
# Off-machine backup of masters, voice and bed (defaults to your OneDrive folder).
# BACKUP_ENABLED=true
# BACKUP_ONEDRIVE_DIR=
# Optional direct OneDrive API transport; enrollment and recovery: docs/backup.md.
# Preserve each environment's existing settings; configure production separately.
# BACKUP_TRANSPORT=onedrive-api
# RELIC_ENVIRONMENT=production
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_SCOPE=appfolder
# Custom drive-root path requires ONEDRIVE_SCOPE=files and fresh consent.
# ONEDRIVE_BACKUP_PATH=Backups/Content Creation/Relic & Riddle
# BACKUP_SPOOL_DIR=
# BACKUP_KEY_FILE=
# ONEDRIVE_TOKEN_CACHE=
# BACKUP_SYNC_FOLDER_FALLBACK=false
# Backup worker retention (docs/backup.md): verified hourly SQLite copies and cloud-verified daily archives kept
# locally (OneDrive copies are never deleted). The status receipt the pipeline reads for /status.
# BACKUP_DATABASE_KEEP=48
# BACKUP_SNAPSHOT_KEEP=7
# BACKUP_STATUS_FILE=data/backup-status.json
# Parallel video encodes during a render (1-8).
# RENDER_ENCODING_SLOTS=2

# --- Picture coverage (2026-11-02), all optional ---
# Rounds a line no photo shows goes back to the writer before the voice (default 2)
# PREVOICE_REWRITE_ROUNDS=2
# Fallback cascade under a line no photo shows: same-kind photo, detail crop, archive film, map, graphic, reconstruction
# PICTURE_CASCADE=true
# DETAIL_CROP_MIN_WIDTH=600
# Topics with fewer distinct approved authoritative photos are demoted (and said) at topic selection (default 8)
# TOPIC_MIN_AUTHORITATIVE_IMAGES=8
# Extra open-access sources (no keys needed). Openverse and the Art Institute stay off until their APIs are checked
# live; the Library of Congress is on by default (operator decision 2026-11-03)
# MUSEUM_OPENVERSE_ENABLED=false
# Optional Flickr key for original-source licence verification; Flickr results are refused without it.
# FLICKR_API_KEY=
# MUSEUM_LOC_ENABLED=true
# MUSEUM_ARTIC_ENABLED=false
# Photo readiness (QF-58; constants in src/config.py, not settings): a video needs at least 9 distinct usable
# photographs (MIN_SCENE_IMAGES), one per photo beat when the narration has more; an automatic pool with fewer than
# 12 usable photos is searched again once its last recorded search is 90 days old (PHOTO_POOL_REFRESH_BELOW/_DAYS);
# a refill runs at most 3 fetch/review passes (PHOTO_POOL_FETCH_PASSES) and a pool at the floor searched within the
# period is not searched again; a Reel photo stays on screen at most 6 seconds (REEL_PHOTO_HOLD_MAX) and is never
# shown twice (a detail crop never counts as a photo; one per photograph), or the run stops before the render with
# the reason (decisions/QF-58-gate.md). The refill for the photo beats is decided from the script, before the voice.

# --- Illustration tier (2026-11-02), all optional ---
# Labelled illustrations (scratchboard engraving house style) for lines no authoritative photo shows.
# Model id (checked against Google's docs 2026-11-02; an unreachable model means no illustration, logged).
# Needs generativelanguage.googleapis.com. gemini-nano-banana-2.1 is the faster, cheaper alternative.
# IMAGE_GEN_MODEL=gemini-3-pro-image
# auto | gemini (generateContent, image output) | imagen (legacy :predict)
# IMAGE_GEN_API=auto
# Candidates requested per beat (1-4); API calls a run may make in all, rejected candidates included
# IMAGE_GEN_CANDIDATES=4
# IMAGE_GEN_MAX_CALLS_PER_RUN=8
# Illustrated beats: Reels/Shorts use MAX_GAP_IMAGES_PER_RUN (2) and at most this share of the runtime; long-form this many
# IMAGE_GEN_MAX_RUNTIME_SHARE=0.15
# IMAGE_GEN_MAX_LONGFORM=4
# IMAGE_GEN_LONGFORM_SECONDS=180
# IMAGE_GEN_MIN_SHOT_SECONDS=1.5
# Text screen needs pytesseract + tesseract; without them every candidate is rejected unless this is false
# IMAGE_GEN_REQUIRE_OCR=true
# IMAGE_GEN_MIN_SHARPNESS=40
# Reference-grounded illustration: references per request (1-3), the comparison's minimum confidence, whether museum /
# Library of Congress images may be fetched as references, and the output size (512 | 1K | 2K | 4K)
# IMAGE_GEN_REFERENCE_MAX=3
# IMAGE_GEN_REFERENCE_MIN_CONFIDENCE=0.85
# IMAGE_GEN_REMOTE_REFERENCES=true
# IMAGE_GEN_IMAGE_SIZE=2K
# IMAGE_GEN_SHOW_MIN_SIDE=720
# IMAGE_GEN_TIMEOUT=60
# Estimated USD per illustration request, charged against MEDIA_MONTHLY_BUDGET_USD before it is sent and recorded
# as "AI images" spend on success. [UNVERIFIED] list price, not yet read from billing; minimum 0.01.
# IMAGE_GEN_COST_USD=0.14

# ==============================================================================
# SET BY THE LAUNCHER, NEVER IN .env
# ==============================================================================
# The production launcher sets these in the process environment; the app reads them at each use and leaves
# them unset in development (nothing to install, nothing to announce). Do not add them to .env.
# RELIC_APP_ROOT: the app root whose .env is read (src/service_runtime.py; set before src/config is imported).
# RELIC_DEPLOY_REQUEST: the file /deploy writes to ask the release deployer for a check now (src/control.py).
# RELIC_DEPLOY_STATUS: the release deployer's status file, read for /deploy and its notices (src/control.py).
# RELIC_RELEASE_RECEIPT: the receipt the release deployer leaves after an install or rollback, announced once
# by the bot (main.py announce_release). Set by deployment/windows/runtime/Start-ContentVmWorkload.ps1.
