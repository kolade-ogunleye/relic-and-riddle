# ==============================================================================
# RELIC & RIDDLE — CONFIGURATION
# Copy to .env. Real environment variables take precedence over this file.
# Run `python main.py health --live` to check what is still missing.
# ==============================================================================

# --- Claude: script writing + search-grounded fact checking (required for new topics) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_MODEL=claude-opus-5-5
# Tried in order if the main model is overloaded or unavailable (uses the same account credit):
# CLAUDE_FALLBACK_MODELS=claude-sonnet-5-5
# Optional monthly spend cap in USD (0 = none). /status shows month-to-date spend.
# When reached: switch to CLAUDE_BUDGET_MODEL, or stop runs (and alert) if it is empty.
# CLAUDE_MONTHLY_BUDGET_USD=0
# CLAUDE_BUDGET_MODEL=claude-sonnet-5-5

# --- Per-beat images (extra Wikimedia Commons pictures matched to individual lines) ---
# BEAT_IMAGES_ENABLED=true
# CC BY-SA is off by default: share-alike asks that the video itself carry the same licence.
# BEAT_IMAGES_ALLOW_SHARE_ALIKE=false

# --- Second, independent fact check (runs after the first passes) ---
# Claude models tried in order (best first). Fable 5.1 is the most rigorous but costs about
# $3-4 per check; "claude-opus-5-5" alone costs about a fifth of that.
# SECOND_CHECK_MODELS=claude-fable-5-1,claude-opus-5-5
# SECOND_CHECK_ENABLED=true
# When the second check disputes a claim the first passed, this model re-checks once and decides.
# SECOND_CHECK_ESCALATION_MODEL=claude-fable-5-1
# Simple text tasks (picture search queries, music mood):
# LIGHT_TASK_MODELS=claude-sonnet-5-5,claude-opus-5-5
# Music source order: library (approved free tracks first) or elevenlabs (generated score first)
# MUSIC_PREFER=library
# Monthly cap for pay-per-use media APIs (AI video), USD; 0 = paid media APIs off
# MEDIA_MONTHLY_BUDGET_USD=0

# Free last-resort checker: a Gemini API key from https://aistudio.google.com (free tier).
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash

# --- Voice ---
# Real runs need a commercially licensed voice: ElevenLabs on a paid plan (Starter or above;
# the Free plan has no commercial licence) and/or Azure Speech (free F0 tier, 0.5M chars/month,
# portal.azure.com > Speech service; same en-US-ChristopherNeural voice). edge-tts is test-only.
# AZURE_SPEECH_KEY=your_azure_speech_key
# AZURE_SPEECH_REGION=eastus
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# --- Telegram human approval ---
# 1. Create a bot with @BotFather.  2. Get your numeric user ID from @userinfobot.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Comma-separated user IDs allowed to approve (defaults to TELEGRAM_CHAT_ID).
# TELEGRAM_APPROVER_IDS=123456789
# APPROVAL_TIMEOUT_SECONDS=3600

# --- Publisher 1: Upload-Post.com (Facebook + Instagram) ---
UPLOAD_POST_API_KEY=your_upload_post_api_key_here
# The Upload-Post profile ("user") your social accounts are connected to.
UPLOAD_POST_USER=your_upload_post_profile_here
# Needed only if more than one Facebook Page is connected.
# UPLOAD_POST_FACEBOOK_PAGE_ID=

# --- Publisher 2: Instagram Graph API direct (fallback, Instagram only) ---
# Token from Facebook Login for Business with instagram_content_publish permission.
META_ACCESS_TOKEN=your_meta_access_token_here
META_IG_ACCOUNT_ID=your_instagram_business_account_id_here
# META_GRAPH_VERSION=v26.0

# --- Publisher 3: Facebook Page Reels direct (fallback, Facebook only) ---
# Page access token with pages_show_list, pages_read_engagement, pages_manage_posts
# (defaults to META_ACCESS_TOKEN if that is a Page token).
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=

# --- Publishing & schedule ---
META_IS_AI_GENERATED=true
DEFAULT_TIMEZONE=America/New_York
# Posting slots, in the audience's timezone (daemon only; CLI publishing is immediate).
# Reels alternate daily between REEL_POST_TIMES; Stories follow STORY_DELAY_MINUTES later;
# carousels go out on CAROUSEL_DAYS at whichever Reel time that day's Reel isn't using.
# POST_TIMEZONE=America/New_York
# POST_SCHEDULING=true
# REEL_POST_TIMES=12:00,19:00
# STORY_DELAY_MINUTES=45
# CAROUSEL_DAYS=tue,wed,thu
SCHEDULE_DAILY_RUN_TIME=09:00

# --- Wikimedia Commons image fetcher (optional) ---
# A URL or email Wikimedia can contact you at; raises its rate limits for scripts/fetch_commons_images.py
# COMMONS_CONTACT=

# --- Operations (optional) ---
# Daily "daemon alive" Telegram message time (in DEFAULT_TIMEZONE)
# HEARTBEAT_TIME=08:00
# Dead-man's switch: create a free check at https://healthchecks.io and paste its ping URL.
# It alerts you by email if the daily heartbeat stops (PC off, crash, no internet).
# HEALTHCHECK_PING_URL=
