# ==============================================================================
# AUTONOMOUS META CONTENT ENGINE — CONFIGURATION
# Copy to .env. Real environment variables take precedence over this file.
# Run `python main.py health --live` to check what is still missing.
# ==============================================================================

# --- Claude: script writing + search-grounded fact checking (required for new topics) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_MODEL=claude-opus-5-5

# --- Voice (optional; falls back to free edge-tts) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# --- Telegram human approval ---
# 1. Create a bot with @BotFather.  2. Get your numeric user ID from @userinfobot.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Comma-separated user IDs allowed to approve (defaults to TELEGRAM_CHAT_ID).
# TELEGRAM_APPROVER_IDS=123456789
# APPROVAL_TIMEOUT_SECONDS=3600

# --- Publisher 1: Upload-Post.com (Facebook + Instagram) ---
UPLOAD_POST_API_KEY=your_upload_post_api_key_here
# The Upload-Post profile ("user") your social accounts are connected to.
UPLOAD_POST_USER=your_upload_post_profile_here
# Needed only if more than one Facebook Page is connected.
# UPLOAD_POST_FACEBOOK_PAGE_ID=

# --- Publisher 2: Instagram Graph API direct (fallback, Instagram only) ---
# Token from Facebook Login for Business with instagram_content_publish permission.
META_ACCESS_TOKEN=your_meta_access_token_here
META_IG_ACCOUNT_ID=your_instagram_business_account_id_here
# META_GRAPH_VERSION=v26.0

# --- Publishing & schedule ---
META_IS_AI_GENERATED=true
DEFAULT_TIMEZONE=America/New_York
SCHEDULE_DAILY_RUN_TIME=09:00

# --- Wikimedia Commons image fetcher (optional) ---
# A URL or email Wikimedia can contact you at; raises its rate limits for scripts/fetch_commons_images.py
# COMMONS_CONTACT=
